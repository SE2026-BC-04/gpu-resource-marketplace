# Local development only. Replace these values for any shared environment.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
POSTGRES_DB=gpu_marketplace
POSTGRES_USER=gpu_marketplace
POSTGRES_PASSWORD=local-dev-only-change-me
# Local-development sample only: this is the database bootstrap/owner login, not a D1 runtime-role check.
GPU_MARKETPLACE_API_DATABASE_URL=postgresql+psycopg://gpu_marketplace:local-dev-only-change-me@postgres:5432/gpu_marketplace
GPU_MARKETPLACE_MANAGER_DATABASE_URL=postgresql+psycopg://gpu_marketplace:local-dev-only-change-me@postgres:5432/gpu_marketplace
# Shared deployments must use separate operator-provisioned gpm_api_app and gpm_manager_app logins.
GPU_MARKETPLACE_JWT_SECRET=
# Independent, stable HMAC key for Listing cursors; generate once for local use.
GPU_MARKETPLACE_LISTING_CURSOR_SECRET=
GPU_MARKETPLACE_CORS_ORIGINS=["http://localhost:5173"]
GPU_MARKETPLACE_LOG_LEVEL=INFO
SIMULATOR_LOG_LEVEL=INFO
